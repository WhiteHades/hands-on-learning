name: ci

on:
  push:
  pull_request:

permissions:
  contents: read

jobs:
  native:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
      - name: Install dependencies
        run: |
          sudo apt-get update
          sudo apt-get install --yes gcc gcc-14 make pkg-config libncurses-dev libjson-c-dev libcurl4-openssl-dev sqlite3
      - name: Build and test
        run: make CC=gcc-14 check
      - name: Validate the demo course
        run: build/hands-on-learning validate courses/demo.holcourse
      - name: Run sanitizers
        run: |
          make CC=gcc-14 clean
          make CC=gcc-14 SANITIZE=1 test
